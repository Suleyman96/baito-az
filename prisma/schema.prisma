generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  /// A single day of work at a set date and time, e.g. 5 hours of yard cleaning
  ONE_DAY
}

/// What the salary amount is for
enum PayPeriod {
  MONTH
  DAY
  HOUR
  /// The whole job (one-day jobs)
  JOB
}

/// PENDING: awaiting admin moderation, ACTIVE: publicly listed
enum JobStatus {
  PENDING
  ACTIVE
  CLOSED
  REJECTED
  /// The work is done (set by the employer); its hired workers and the employer can review each other
  COMPLETED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  ACCEPTED
  REJECTED
}

/// Signs in with email or phone, so at least one of them is set (checked in the app)
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  /// Normalized mobile number, e.g. +994501234567
  phone        String?       @unique
  passwordHash String
  name         String
  role         Role          @default(SEEKER)
  /// Optional public social links, shown on the worker or company profile. Only the username is
  /// stored (WhatsApp: the number's digits); links are rebuilt in src/lib/social-links.ts
  instagram    String?
  facebook     String?
  tiktok       String?
  whatsapp     String?
  telegram     String?
  /// Set by an admin: the user cannot log in and their jobs are hidden
  blockedAt    DateTime?
  /// Set when the user deleted their profile. The row stays (with personal data removed) so jobs,
  /// applications and reviews other people took part in keep their history
  deletedAt    DateTime?
  /// When the user accepted the Terms of Use and the Privacy Policy at sign-up, and which version
  /// (src/config/legal.ts). Empty for accounts created before consent was recorded
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Profile photo; for employers it is also shown as the company logo
  avatar       Image?        @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  avatarId     String?       @unique
  /// The CV used for new applications (job seekers)
  resume       Resume?       @relation("CurrentResume", fields: [resumeId], references: [id], onDelete: SetNull)
  resumeId     String?       @unique
  /// Every CV this user uploaded that is still kept (current, or attached to an application)
  resumes      Resume[]      @relation("ResumeOwner")
  reviewsWritten  Review[]   @relation("ReviewAuthor")
  reviewsReceived Review[]   @relation("ReviewSubject")
  notifications Notification[]
  /// Password reset links for this account (src/lib/auth/password-reset.ts), and those this admin made for others
  passwordResets PasswordResetToken[] @relation("ResetLinkOwner")
  resetLinksMade PasswordResetToken[] @relation("ResetLinkCreator")
  /// Job offers an employer sent to job seekers, and those a job seeker received
  offersSent     JobOffer[]  @relation("OfferEmployer")
  offersReceived JobOffer[]  @relation("OfferWorker")
  /// Job seekers' public work profile (directory)
  workerProfile WorkerProfile?
  company      Company?
  applications Application[]
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Login session. The browser cookie holds a random token; only its SHA-256 hash is stored here
model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A one-time password reset link. The id is the SHA-256 hash of the token in the link, so a leaked
/// database copy cannot be used to reset a password. Deleted once used.
/// Emailed links: `email` is the address it was sent to, and the link stops working if the account's email changes.
/// Links an admin made for an account without email (handed over after checking who asks): `createdBy` is that admin
model PasswordResetToken {
  id          String   @id
  user        User     @relation("ResetLinkOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  email       String?
  createdBy   User?    @relation("ResetLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// A failed login, kept for a short while to slow down password guessing (src/lib/auth/login-throttle.ts).
/// `key` is the normalized email or phone that was tried; the rows of a key are cleared after a successful login
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  /// The name compared case- and space-insensitively (src/lib/company-name.ts), so one company is
  /// registered once. Null for private persons, who post under their own name
  nameKey     String?  @unique
  description String?  @db.Text
  phone       String?
  /// Optional business location: a written address and/or a point picked on the map
  address     String?
  latitude    Float?
  longitude   Float?
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String   @unique
  jobs        Job[]
  createdAt   DateTime @default(now())
}

/// Category names are translated in the UI by slug (see dictionaries)
model Category {
  id   Int    @id @default(autoincrement())
  slug String @unique
  jobs Job[]
}

/// District names are translated in the UI by slug (see dictionaries)
model District {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  /// Official code in the State Statistics Committee's territorial classification (src/config/regions.ts)
  code      String?    @unique
  locations Location[]
}

/// Town or village inside a district
model Location {
  id         Int      @id @default(autoincrement())
  name       String
  /// Official code in the territorial classification; null for places added before it that it does not
  /// list for this district (kept for any job or profile that uses them, not offered in pickers)
  code       String?  @unique
  /// Order in the village picker: the city or town first, then settlements, then villages, alphabetically
  position   Int      @default(0)
  district   District @relation(fields: [districtId], references: [id])
  districtId Int
  jobs       Job[]
  workers    WorkerProfile[]

  // Different districts can have villages with the same name
  @@unique([districtId, name])
}

model Job {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  employmentType EmploymentType
  /// Salary in AZN per payPeriod. One-day jobs use salaryMin only
  salaryMin      Int?
  salaryMax      Int?
  payPeriod      PayPeriod      @default(MONTH)
  /// One-day jobs: start date and time, length in hours, and how many workers are needed
  workStart      DateTime?
  durationHours  Int?
  workersNeeded  Int?
  /// Phone shown on the job; falls back to the company phone
  contactPhone   String?
  /// New posts wait for admin approval
  status         JobStatus      @default(PENDING)
  /// Admin's reason when rejecting, shown to the employer
  rejectReason   String?
  completedAt    DateTime?
  reviews        Review[]
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  category       Category       @relation(fields: [categoryId], references: [id])
  categoryId     Int
  location       Location       @relation(fields: [locationId], references: [id])
  locationId     Int
  applications   Application[]
  /// Offers that name this job
  offers         JobOffer[]
  /// Optional photos of the workplace or the work
  images         Image[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([companyId])
  @@index([categoryId])
  @@index([locationId])
}

model Application {
  id        String            @id @default(cuid())
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String?           @db.Text
  status    ApplicationStatus @default(NEW)
  /// The CV as it was when the seeker applied; later replacements do not change what the employer received
  resume    Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeId  String?
  notification Notification?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  // One application per seeker and job: a retried or repeated submit cannot create a second one
  @@unique([jobId, userId])
  @@index([resumeId])
}

/// A job seeker's CV file (PDF, DOC or DOCX). Private: served only to its owner,
/// to employers it was sent to with an application, and to admins (see app/api/resumes/[id]).
/// Never changed in place: replacing a CV creates a new row.
model Resume {
  id           String        @id @default(cuid())
  owner        User          @relation("ResumeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  currentOf    User?         @relation("CurrentResume")
  applications Application[]
  data         Bytes
  /// application/pdf, application/msword or the .docx type (checked from the file's bytes)
  mimeType     String
  /// Original file name, cleaned of paths
  fileName     String
  size         Int
  createdAt    DateTime      @default(now())

  @@index([ownerId])
}

enum EmailStatus {
  /// Not tried yet
  PENDING
  SENT
  FAILED
  /// No email service is configured; the notification is only shown on the site
  NOT_CONFIGURED
  /// The recipient has no email address (phone-only account)
  NO_ADDRESS
}

/// "Someone applied to your job", for the employer. One per application, so a retried
/// submit never notifies twice. Shown on the site; emailed when an email service is configured.
model Notification {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String      @unique
  readAt        DateTime?
  emailStatus   EmailStatus @default(PENDING)
  emailError    String?
  emailedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, readAt])
}

/// An uploaded picture, stored in the database (see src/lib/storage.ts).
/// Either a user's profile photo or one of a job's images.
model Image {
  id        String   @id @default(cuid())
  data      Bytes
  /// image/jpeg, image/png or image/webp (checked from the file's bytes, not the name)
  mimeType  String
  size      Int
  /// Profile photo of this user
  avatarOf  User?    @relation("UserAvatar")
  /// Image of this job, in display order
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  /// Work sample in a job seeker's portfolio
  portfolioOf   WorkerProfile? @relation(fields: [portfolioOfId], references: [id], onDelete: Cascade)
  portfolioOfId String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId, position])
  @@index([portfolioOfId, position])
}

/// A star rating and comment between an employer and a worker hired for a completed job.
/// Both directions: employer → worker and worker → employer. One review per job, author and subject;
/// reviews are never edited. Rating range and "not about yourself" are also CHECK constraints in the migration.
model Review {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  /// 1–5 stars
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([jobId, authorId, subjectId])
  @@index([subjectId, createdAt])
}

enum Workplace {
  ONSITE
  REMOTE
  ANY
}

/// A job seeker's work profile, shown in the "İş axtaranlar" directory once they switch `visible` on.
/// Holds no contact details: name and phone stay on User and are never read by directory queries.
/// Professions and skills are codes from src/config/professions.ts.
model WorkerProfile {
  id                    String           @id @default(cuid())
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String           @unique
  /// Listed in the directory only when the seeker turns this on
  visible               Boolean          @default(false)
  ageRange              String?
  bio                   String?          @db.Text
  primaryProfession     String
  additionalProfessions String[]
  skills                String[]
  experienceYears       Int?
  workHistory           String?          @db.Text
  certificates          String?          @db.Text
  /// Approximate location: district (required) and optionally a village; never a street address
  district              String
  location              Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId            Int?
  preferredDistricts    String[]
  maxCommuteKm          Int?
  willingToRelocate     Boolean          @default(false)
  workTypes             EmploymentType[]
  availableFrom         DateTime?
  availableWeekdays     Boolean          @default(true)
  availableWeekends     Boolean          @default(false)
  expectedPay           Int?
  expectedPayPeriod     PayPeriod        @default(MONTH)
  workplace             Workplace        @default(ONSITE)
  portfolio             Image[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([visible, district])
  @@index([primaryProfession])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// An employer's message or job offer to a job seeker, sent from the seeker's public profile
model JobOffer {
  id          String      @id @default(cuid())
  employer    User        @relation("OfferEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  employerId  String
  worker      User        @relation("OfferWorker", fields: [workerId], references: [id], onDelete: Cascade)
  workerId    String
  /// Optional: one of the employer's open jobs the offer is about (kept as null if that job is deleted)
  job         Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId       String?
  message     String      @db.Text
  status      OfferStatus @default(PENDING)
  /// The job seeker's answer
  reply       String?     @db.Text
  respondedAt DateTime?
  /// When the job seeker first saw the offer, and when the employer first saw the answer (unread badges)
  seenAt      DateTime?
  replySeenAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([workerId, createdAt])
  @@index([employerId, createdAt])
  @@index([jobId])
}

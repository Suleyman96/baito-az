DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/baito?schema=public"

# Google Maps (optional). Without a key, companies can still save an address and visitors get an
# "Open in Google Maps" link; with a key, the map picker and map previews turn on.
# Enable "Maps JavaScript API" and "Geocoding API" in Google Cloud, and restrict the key to your domains (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional Map ID for styled maps; Google's "DEMO_MAP_ID" is used when empty
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Public address of the site, used in links inside notification emails
APP_URL="http://localhost:3000"

# Email sending through Resend (optional). Without a key, nothing is emailed: notifications only show on the site.
# Create a key with "Sending access" at resend.com → API Keys.
RESEND_API_KEY=""
# Sender, from a domain verified in Resend, e.g. "Baito.az <no-reply@baito.az>". When empty, Resend's test
# sender onboarding@resend.dev is used, which only delivers to the Resend account's own email.
MAIL_FROM=""

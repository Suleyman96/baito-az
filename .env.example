DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zaqawork?schema=public"

# Google Maps (optional). Without a key, companies can still save an address and visitors get an
# "Open in Google Maps" link; with a key, the map picker and map previews turn on.
# Enable "Maps JavaScript API" and "Geocoding API" in Google Cloud, and restrict the key to your domains (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional Map ID for styled maps; Google's "DEMO_MAP_ID" is used when empty
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Public address of the site, used in links inside notification emails (once email sending is set up)
APP_URL="http://localhost:3000"
